{
  "manifest_version": 3,
  "name": "Absolute Cinema Mode for YouTube",
  "version": "1.0.0",
  "description": "Makes YouTube's Cinema mode fill the window, auto-hide the top bar, and dock live chat to the right.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Absolute Cinema Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/content.css"],
      "js": ["src/settings.js", "src/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/live_chat_replay*"],
      "css": ["src/chat-frame.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-absolute-cinema-mode@extension",
      "strict_min_version": "115.0"
    }
  }
}
